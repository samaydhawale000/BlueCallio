{
  "name": "@bluecallio/sdk",
  "version": "0.2.2",
  "description": "Official JavaScript and TypeScript SDK for BlueCallio, a developer-focused real-time communication infrastructure platform for audio, video, screen sharing and WebRTC applications.",
  "homepage": "https://bluecallio.com",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "keywords": [
    "bluecallio",
    "video",
    "webrtc",
    "communication",
    "sdk",
    "voice",
    "audio",
    "screen-sharing",
    "typescript",
    "api"
  ],
  "license": "MIT",
  "dependencies": {
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
