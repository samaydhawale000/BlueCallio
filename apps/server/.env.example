# ── Server ──────────────────────────────────────────────────
PORT=3005

# ── Database ─────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/bluecall"

# ── Auth ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_random_chars
JWT_REFRESH_SECRET=replace_with_64_different_random_chars

# ── TURN ─────────────────────────────────────────────────────
TURN_SERVER=localhost
TURN_SECRET=replace_with_strong_random_secret

# ── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
