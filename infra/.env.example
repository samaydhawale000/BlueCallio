# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_USER=bluecall
POSTGRES_PASSWORD=change_this_strong_password
POSTGRES_DB=bluecall

# ── NestJS Server ───────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_64_random_chars
JWT_REFRESH_SECRET=replace_with_64_different_random_chars

# ── TURN Server ─────────────────────────────────────────────
# Your VPS public IP (run: curl ifconfig.me)
TURN_SERVER=1.2.3.4
TURN_SECRET=replace_with_strong_random_secret

# ── URLs ────────────────────────────────────────────────────
FRONTEND_URL=https://yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com
